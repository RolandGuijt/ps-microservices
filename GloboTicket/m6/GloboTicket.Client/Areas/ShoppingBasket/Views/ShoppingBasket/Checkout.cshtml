@model GloboTicket.Web.Models.View.BasketCheckoutViewModel

<h2 class="text-danger">@ViewBag.ErrorMessage</h2>

<form asp-action="Checkout" method="post" class="form-horizontal" role="form">
    <h3>Your total is $@Model.BasketTotal</h3>
    <h4>You're just one step away from placing your order.</h4>

    <div asp-validation-summary="All" class="text-danger"></div>
    
    <div class="form-group">
        <input type="hidden" asp-for="BasketTotal"/>
        <label asp-for="CardNumber" class="col-md-2 control-label"></label>
        <div class="col-md-5">
            <input asp-for="CardNumber" class="form-control"/>
            <span asp-validation-for="CardNumber" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group mt-2">
        <div class="col-md-offset-2 col-md-5">
            <input type="submit" class="btn btn-primary" value="Place order" />
        </div>
    </div>

</form>