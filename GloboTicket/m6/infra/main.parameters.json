{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "globoticket_sql_mysql_password": {
        "value": "${AZURE_GLOBOTICKET_SQL_MYSQL_PASSWORD}"
      },
      "globoticket_sql_postgres_password": {
        "value": "${AZURE_GLOBOTICKET_SQL_POSTGRES_PASSWORD}"
      },
      "transportPassword": {
        "value": "${AZURE_TRANSPORT_PASSWORD}"
      },
      "transportUserName": {
        "value": "${AZURE_TRANSPORT_USER_NAME}"
      },
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      }
    }
  }
  